# Internal build mode — the product hosted on Microchip infrastructure (req #4076).
#   Build:  vite build --mode internal        (npm run build:internal)
# Loaded ON TOP of .env, so every value .env sets that the internal product must
# not inherit is overridden here. The keys are resolved by
# src/config/productConfig.js; design record memory/enterprise-internal-hosting.md.
# Zero AWS, no link to darwin.one: `npm run check:internal` proves the bundle.

# The product's user-visible name. RENAME THE PRODUCT HERE — nothing else.
VITE_PRODUCT_NAME=Topology
VITE_PRODUCT_TAGLINE=

# Same-origin API behind nginx (/api → the internal API Gateway, req #4079),
# and ONE brand-neutral database for user data and swarm ops alike.
VITE_API_BASE=/api
VITE_DARWIN_DATABASE=internal
VITE_OPS_DATABASE=internal
VITE_BUILDVIZ_DATABASE=none

# nginx authenticates; the app holds no credential and shows no login.
VITE_AUTH_MODE=proxy

# Topology (systems2) and Swarm (swarm/*, agents/*, machines). Home = Topology.
VITE_APP_SCOPE=systems,swarm

# No separate production site — a requirement link stays on this origin.
VITE_PROD_BASE_URL=

# .env's darwin.one OAuth redirects and Strava id belong to darwin.one.
VITE_LOGIN_REDIRECT=
VITE_LOGOUT_REDIRECT=
VITE_STRAVA_CLIENT_ID=
